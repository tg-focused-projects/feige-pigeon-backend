# =============================================================
# feige-pigeon systemd 环境文件模板（目标机路径：/opt/feige/env.conf）
# 格式为 KEY=VALUE（不要 export 前缀）；由 init-server.sh 自动从
# 旧式 /data/deploy/conf_feige/env.conf 迁移生成，此模板供新机器参考。
# 权限应设为 600。
# 注意：dev-login 上线前必须置 false，并填真实小程序 appid/secret。
# =============================================================
FG_PORT=8080

# dev 登录兜底（本地/测试联调用 true；上线必须 false）
FG_DEV_LOGIN=true

# 数据库连接（SpringBoot 宽松绑定覆盖 application.yml）
SPRING_DATASOURCE_URL=jdbc:mysql://<DB_HOST>:3306/feige_pigeon?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASS>

# 微信（测试小程序）
FG_WECHAT_APPID=
FG_WECHAT_SECRET=
FG_SIGN_SECRET=soogif-feige-dev-sign
FG_ARRIVAL_TEMPLATE_ID=

# JVM 参数（可选）
FG_JAVA_OPTS=-Xms256m -Xmx512m
