# =============================================================
# 飞鸽传书 feige-pigeon 环境配置（部署服务器 /data/deploy/conf_feige/env.conf）
# 由 deploy-feige-pigeon.sh source；部署时按环境修改即可。
# 注意：dev-login 上线前必须置 false，并填真实小程序 appid/secret。
# =============================================================
export FG_PORT=8080

# dev 登录兜底（本地/测试联调用 true；上线必须 false）
export FG_DEV_LOGIN=true

# 测试库连接（SpringBoot 宽松绑定覆盖 application.yml）
export SPRING_DATASOURCE_URL='jdbc:mysql://<测试库IP>:3306/feige_pigeon?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai'
export SPRING_DATASOURCE_USERNAME=<测试库用户>
export SPRING_DATASOURCE_PASSWORD=<测试库密码>

# 微信（测试小程序）
export FG_WECHAT_APPID=<测试小程序appid>
export FG_WECHAT_SECRET=<测试小程序secret>
export FG_SIGN_SECRET=<测试签名盐>
export FG_ARRIVAL_TEMPLATE_ID=

# ---------- 多鸽付费（V1.2 真实虚拟支付 / 米大师 xpay） ----------
# 付费开关：true = 第2~6只必须购买（规格15.6）
export PAID_PIGEON_ENABLED=true
# 关闭模拟支付：必须 false，否则 confirm 仍 mock 直接成功
export FG_PAY_MOCK=false
# 虚拟支付基本配置：OfferID / 现网 AppKey（HMAC-SHA256 签名密钥；勿用沙箱 AppKey）
export FG_PAY_OFFER_ID=<虚拟支付OfferID>
export FG_PAY_APP_KEY=<虚拟支付现网AppKey>
# 槽位价格（分）：位置2~6，须与虚拟支付后台「道具管理」道具价格一致（A1 定稿后更新）
export FG_PIGEON_PRICES=0,100,300,600,1000,1500

# ---------- 虚拟支付「发货推送配置」消息推送（接收 xpay_goods_deliver_notify） ----------
# token：微信后台「消息推送配置 → token」（GET 验 URL 用）
export FG_MP_PUSH_TOKEN=<消息推送token>
# EncodingAESKey：43 位 A-Za-z0-9（兼容模式解密用）
export FG_MP_PUSH_AES_KEY=<EncodingAESKey>
# 消息加解密方式：兼容模式（0明文/1兼容/2安全，当前用兼容模式=1）
export FG_MP_PUSH_ENCRYPT_MODE=1

# JVM 参数（可选）
export FG_JAVA_OPTS='-Xms256m -Xmx512m'
