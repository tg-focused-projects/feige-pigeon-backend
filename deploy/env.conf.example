# =============================================================
# 飞鸽传书 feige-pigeon 环境配置（部署服务器 /data/deploy/conf_feige/env.conf）
# 由 deploy-feige-pigeon.sh source；部署时按环境修改即可。
# 注意：dev-login 上线前必须置 false，并填真实小程序 appid/secret。
# =============================================================
export FG_PORT=8080

# dev 登录兜底（本地/测试联调用 true；上线必须 false）
export FG_DEV_LOGIN=true

# 测试库连接（SpringBoot 宽松绑定覆盖 application.yml）
export SPRING_DATASOURCE_URL='jdbc:mysql://<测试库IP>:3306/feige_pigeon?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai'
export SPRING_DATASOURCE_USERNAME=<测试库用户>
export SPRING_DATASOURCE_PASSWORD=<测试库密码>

# 微信（测试小程序）
export FG_WECHAT_APPID=<测试小程序appid>
export FG_WECHAT_SECRET=<测试小程序secret>
export FG_SIGN_SECRET=<测试签名盐>
export FG_ARRIVAL_TEMPLATE_ID=

# JVM 参数（可选）
export FG_JAVA_OPTS='-Xms256m -Xmx512m'
